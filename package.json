{
  "name": "harbormaster",
  "private": true,
  "version": "0.0.1",
  "description": "A kanban harbor for coding-agent tasks — every task gets a berth: worktree, branch, session, pane.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "install-extension": "pi install \"$(pwd)/packages/extension\"",
    "migrate-from-pihome": "tsx packages/core/src/migration/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
