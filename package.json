{
  "name": "harbormaster",
  "private": true,
  "version": "0.0.1",
  "description": "A kanban harbor for coding-agent tasks — every task gets a berth: worktree, branch, session, pane.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
