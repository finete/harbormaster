{
  "name": "@harbormaster/app",
  "private": true,
  "version": "0.0.1",
  "description": "Electron desktop app: kanban board + session panes.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "npm run build -w @harbormaster/core",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pretypecheck": "npm run build -w @harbormaster/core",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:e2e",
    "postinstall": "electron-rebuild --force --only node-pty"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@electron-toolkit/utils": "3.0.0",
    "@harbormaster/core": "0.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dockview-react": "1.17.1",
    "lucide-react": "0.469.0",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "33.3.1",
    "electron-vite": "2.3.0",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3",
    "vite": "5.4.11"
  }
}
