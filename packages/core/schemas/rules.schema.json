{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/finete/harbormaster/blob/main/packages/core/schemas/rules.schema.json",
  "title": "Harbormaster rules file",
  "description": "Board automation as event → condition → action. `rules.yaml` is the global ordered list; `repos/<repository id>.yaml`, when present, replaces it for that repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "on", "do"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Unique within the file; shown in the audit log."
        },
        "description": {
          "type": "string"
        },
        "on": {
          "description": "Event type(s): exact (`github.pr.mergedChanged`) or glob (`github.pr.*`; `*` = one segment, `**` = any).",
          "oneOf": [
            {
              "$ref": "#/definitions/eventPattern"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/eventPattern"
              }
            }
          ]
        },
        "if": {
          "type": "string",
          "minLength": 1,
          "description": "CEL over `event`, `task`, `facts`, `repo`; or `js:./file.mjs#fn` (a function in the rules dir returning a boolean)."
        },
        "do": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/action"
          }
        }
      }
    },
    "eventPattern": {
      "type": "string",
      "pattern": "^[A-Za-z0-9*][A-Za-z0-9_.*-]*$"
    },
    "jsRef": {
      "type": "string",
      "pattern": "^js:\\./[^#]+#[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "template": {
      "type": "string",
      "pattern": "^\\$\\{[\\s\\S]+\\}$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "anyOf": [
            {
              "enum": ["move", "inbox", "createTask", "message"]
            },
            {
              "$ref": "#/definitions/jsRef"
            }
          ]
        },
        "with": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "move"
              }
            }
          },
          "then": {
            "required": ["with"],
            "properties": {
              "with": {
                "$ref": "#/definitions/moveInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "inbox"
              }
            }
          },
          "then": {
            "required": ["with"],
            "properties": {
              "with": {
                "$ref": "#/definitions/inboxInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "createTask"
              }
            }
          },
          "then": {
            "required": ["with"],
            "properties": {
              "with": {
                "$ref": "#/definitions/createTaskInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "message"
              }
            }
          },
          "then": {
            "required": ["with"],
            "properties": {
              "with": {
                "$ref": "#/definitions/messageInput"
              }
            }
          }
        }
      ]
    },
    "moveInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": {
          "enum": ["dev", "done", "await"]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Awaiting-kind inputs; for `deploy`, `stage` picks a stage id (default: the entry stage)."
        },
        "enter": {
          "description": "Run the kind's onEnter side effect (push/open PR, squash-merge). Default false.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^\\$\\{[\\s\\S]+\\}$"
            }
          ]
        }
      }
    },
    "inboxInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "action"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": ["openTask", "createTask", "dismiss", "snooze"]
              },
              "with": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "createTaskInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "pr": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "role": {
          "anyOf": [
            {
              "enum": ["author", "reviewer"]
            },
            {
              "type": "string",
              "pattern": "^\\$\\{[\\s\\S]+\\}$"
            }
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "pattern": "^\\$\\{[\\s\\S]+\\}$"
            }
          ]
        }
      }
    },
    "messageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "anyOf": [
            {
              "enum": ["steer", "followUp"]
            },
            {
              "type": "string",
              "pattern": "^\\$\\{[\\s\\S]+\\}$"
            }
          ]
        },
        "to": {
          "type": "string"
        }
      }
    }
  }
}
